# MOB-1198: Firebase web config for «Accedi con Google / Apple» (project finzyappprod).
# Values come from the Firebase console (Project settings → Your apps → Web app).
# Copy to .env.local (never committed) before `pnpm build`. Empty: the two buttons are hidden.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
